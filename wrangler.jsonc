{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "outofbreathed",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Served on outofbreathed.<subdomain>.workers.dev until the domain cutover. Preview URLs are off.
	"workers_dev": true,
	// outofbreathed.com is a Cloudflare zone; www redirects to the bare domain (src/middleware.ts).
	"routes": [
		{ "pattern": "outofbreathed.com", "custom_domain": true },
		{ "pattern": "www.outofbreathed.com", "custom_domain": true }
	],
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "outofbreathed",
			"database_id": "8e8c479c-828d-4e58-8dbd-ff6ddcd5f9ee",
			"migrations_dir": "migrations"
		}
	],
	// Cloudflare Images: resizes uploads into the display copy and thumbnail (free tier: 5,000 unique transforms/month).
	"images": {
		"binding": "IMAGES"
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "outofbreathed-media"
		}
	],
	"vars": {
		// Who may post, edit and moderate (comma-separated Google account emails). Everyone can view.
		"OWNER_EMAILS": "jimshobe@gmail.com",
		// Google sign-in OAuth client (Google Cloud Console). Its secret, and SESSION_SECRET (signs the
		// session cookie), are Worker secrets: `wrangler secret put GOOGLE_CLIENT_SECRET` / `SESSION_SECRET`.
		"GOOGLE_CLIENT_ID": "819812776409-0vf2dfdhamp77sq3h81v3hc3iltj49r1.apps.googleusercontent.com"
	}
}
