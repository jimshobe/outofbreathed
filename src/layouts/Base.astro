---
import '../styles/global.css';
import { pendingCount } from '../lib/comments';

interface Props {
  current: 'timeline' | 'map' | 'post' | 'manage';
  /** Offer "Add to Home Screen" as a standalone app that opens on this page (the owner's post page). */
  homeScreen?: boolean;
  /** Full-screen page (the map): the header floats over the content without a background. */
  overlay?: boolean;
  /** Page title before the site name (a musing's title). */
  title?: string;
}
const { current, homeScreen = false, overlay = false, title } = Astro.props;
const { isOwner, uid, name, avatar } = Astro.locals.viewer;
const here = Astro.url.pathname + Astro.url.search;
// The owner sees a mark by their name while comments wait for approval.
const waiting = isOwner ? await pendingCount() : 0;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title ? `${title.toLowerCase()} · outofbreathed.com` : 'outofbreathed.com'}</title>
    {homeScreen && <link rel="manifest" href="/post.webmanifest" />}
    {homeScreen && <meta name="apple-mobile-web-app-title" content="post" />}
  </head>
  <body data-signed-in={uid ? '1' : undefined} data-owner={isOwner ? '1' : undefined}>
    <header class:list={['site', { overlay }]}>
      <h1>outofbreathed.com</h1>
      <nav>
        <a href="/" aria-current={current === 'timeline' ? 'page' : undefined}>timeline</a>
        <a href="/map" aria-current={current === 'map' ? 'page' : undefined}>map</a>
        {isOwner && <a href="/post" aria-current={current === 'post' ? 'page' : undefined}>post</a>}
        {isOwner && <a href="/manage" aria-current={current === 'manage' ? 'page' : undefined}>manage</a>}
        {uid
          ? <details class="me">
              <summary title={waiting ? 'comments waiting' : undefined}>
                {avatar && <img src={avatar} alt="" referrerpolicy="no-referrer" />}{name?.toLowerCase()}{waiting > 0 && <i class="dot" aria-label="comments waiting"></i>} ▾
              </summary>
              <div class="menu">
                {waiting > 0 && <a href="/manage#settings">{waiting} comment{waiting > 1 ? 's' : ''} waiting ›</a>}
                <a href={`/auth/logout?next=${encodeURIComponent(here)}`}>sign out</a>
              </div>
            </details>
          : <a href={`/auth/login?next=${encodeURIComponent(here)}`}>sign in</a>}
      </nav>
    </header>
    <slot />
  </body>
</html>

<script>
  // The name menu closes on a click elsewhere or Esc.
  const me = document.querySelector('header.site .me') as unknown as HTMLDetailsElement | null;
  if (me) {
    document.addEventListener('click', (e) => { if (me.open && !me.contains(e.target as unknown as Node)) me.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') me.open = false; });
  }
</script>
