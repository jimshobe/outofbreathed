---
import '../styles/global.css';

interface Props { current: 'timeline' | 'map' | 'post' }
const { current } = Astro.props;
const { isOwner } = Astro.locals.viewer;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>outofbreathed.com</title>
  </head>
  <body>
    <header class="site">
      <h1>outofbreathed.com</h1>
      <nav>
        <a href="/" aria-current={current === 'timeline' ? 'page' : undefined}>timeline</a>
        <a href="/map" aria-current={current === 'map' ? 'page' : undefined}>map</a>
        {isOwner && <a href="/post" aria-current={current === 'post' ? 'page' : undefined}>post</a>}
      </nav>
    </header>
    <slot />
  </body>
</html>
