---
// One photo or YouTube video, full column width, with its date · place · caption line.
import { mediaUrl, fmtDay, type MomentView } from '../lib/moments';

interface Props { m: MomentView; /** Lightbox group this photo opens in. */ group: string }
const { m, group } = Astro.props;
// Clamp very tall shots so one photo never fills much more than a screen.
const ratio = m.width && m.height ? Math.max(m.width / m.height, 0.8) : 4 / 5;
---

<article class="mo" id={`m-${m.id}`}>
  {m.source === 'youtube' && m.youtube_id && (
    <div class="media" style="aspect-ratio:16/9">
      <iframe src={`https://www.youtube-nocookie.com/embed/${m.youtube_id}?playsinline=1&rel=0`} title={m.caption ?? 'video'}
        loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" />
    </div>
  )}
  {m.media_key && (
    <a class="media" style={`aspect-ratio:${ratio}`} href={`#p-${m.id}`} data-lb-open={group} data-lb-id={m.id}>
      <img src={mediaUrl(m.media_key)} alt={m.caption ?? ''} loading="lazy" />
    </a>
  )}
  <div class="line">
    <span class="d">{fmtDay(m.taken_at)}</span>
    {m.display_lat != null && m.display_lng != null
      ? <a class="pl" href={`/map#@${m.display_lat},${m.display_lng}`}>{m.place_name?.toLowerCase() ?? 'map'}</a>
      : <span class="pl">{m.place_name?.toLowerCase()}</span>}
    <span class="c">{m.caption}</span>
  </div>
</article>

<style>
  .mo { margin-bottom: 40px; scroll-margin-top: 70px; }
  .media { display: block; width: 100%; background: #0d0d0d; overflow: hidden; }
  a.media { cursor: zoom-in; }
  .media img, .media iframe { width: 100%; height: 100%; object-fit: cover; display: block; border: 0; }
  .line { margin-top: 10px; display: grid; grid-template-columns: 64px minmax(0, max-content) 1fr; gap: 0 14px; align-items: baseline; }
  .d, .pl { color: var(--dim); }
  .pl { max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  a.pl { text-decoration: underline; text-decoration-color: var(--faint); text-underline-offset: 3px; }
  a.pl:hover { color: var(--fg); text-decoration-color: var(--fg); }
  @media (max-width: 700px) {
    .line { grid-template-columns: auto 1fr; gap: 2px 12px; }
    .c { grid-column: 1 / -1; }
  }
</style>
