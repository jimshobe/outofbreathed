---
// A set on the timeline: cover + up to four thumbnails, then "title · dates · place" and its caption.
// Photos open the lightbox over the whole set; the title and "+N" go to the set's page.
import { mediaUrl, type MomentView } from '../lib/moments';
import LightboxData from './LightboxData.astro';
import Comments from './Comments.astro';
import { fmtRange, type SetInfo } from '../lib/timeline';
import PlaceLinks from './PlaceLinks.astro';
import { fmtStats } from '../lib/route';

interface Props { set: SetInfo; moments: MomentView[]; cover: MomentView; start: string; end: string; places: string[]; comments?: number }
const { set, moments, cover, start, end, places, comments = 0 } = Astro.props;

const img = (m: MomentView, small = false) =>
  m.media_key ? mediaUrl(small ? (m.thumb_key ?? m.media_key) : m.media_key)
  : m.youtube_id ? `https://i.ytimg.com/vi/${m.youtube_id}/${small ? 'mqdefault' : 'hqdefault'}.jpg` : null;
const rest = moments.filter((m) => m.id !== cover.id);
const shown = rest.slice(0, 4);
const more = moments.length - 1 - shown.length;
// Photos open in the lightbox over the whole set ("+N" goes to the set page); YouTube covers just link there.
const group = `set-${set.id}`;
const opener = (m: MomentView) => (m.media_key ? { 'data-lb-open': group, 'data-lb-id': m.id } : {});
const stats = set.route_km != null ? fmtStats({ km: set.route_km, secs: set.route_secs ?? null, climb_m: set.route_climb_m ?? null }) : '';
// The first place, linked like a photo's (see PlaceLinks).
const first = places.length ? moments.find((m) => m.place_name === places[0]) : undefined;
---

<article class="set" id={`set-${set.id}`}>
  <div class="grid" class:list={[`n${Math.min(shown.length, 4)}`]}>
    <a class="cover" href={`/sets/${set.id}#p-${cover.id}`} {...opener(cover)} aria-label={set.title}>{img(cover) && <img src={img(cover)} alt="" loading="lazy" />}</a>
    {shown.map((m, i) => (
      <a class="t" href={i === shown.length - 1 && more > 0 ? `/sets/${set.id}` : `/sets/${set.id}#p-${m.id}`}
        {...(i === shown.length - 1 && more > 0 ? {} : opener(m))}>
        {img(m, true) && <img src={img(m, true)} alt="" loading="lazy" />}
        {i === shown.length - 1 && more > 0 && <b>+{more}</b>}
      </a>
    ))}
  </div>
  <LightboxData group={group} moments={moments} />
  <div class="line">
    <a class="title" href={`/sets/${set.id}`}>{set.title.toLowerCase()}</a>
    <span class="meta">
      {fmtRange(start, end)}
      {first && <>{' · '}<PlaceLinks name={first.place_name} zoned={first.zoned} spot_lat={first.spot_lat} spot_lng={first.spot_lng} />{places.length > 1 && ` +${places.length - 1}`}</>}
    </span>
    {Astro.locals.viewer.isOwner && <a class="ed" href={`/manage/sets/${set.id}`}>[edit]</a>}
  </div>
  {stats && <p class="stats">⤳ {stats}</p>}
  {set.caption && <p class="caption">{set.caption}</p>}
  <Comments on={`s:${set.id}`} count={comments} />
</article>

<style>
  .set { margin-bottom: 44px; scroll-margin-top: calc(var(--head) + 24px); }
  .grid { display: grid; gap: 4px; aspect-ratio: 3 / 2; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; }
  .grid.n0 { grid-template-columns: 1fr; grid-template-rows: 1fr; }
  .grid.n1 { grid-template-rows: 1fr; }
  .grid.n3 { grid-template-columns: 2fr 1fr 1fr; }
  .grid.n4 { grid-template-columns: 2fr 1fr 1fr; }
  .cover { grid-row: 1 / -1; }
  .grid.n3 .t:first-of-type { grid-column: 2 / 4; }
  .cover, .t { position: relative; background: #0d0d0d; overflow: hidden; display: block; }
  .grid img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity .2s; }
  .grid a:hover img { opacity: .85; }
  .t b { position: absolute; inset: 0; display: grid; place-items: center; background: #000a; color: var(--fg); font-weight: 400; }
  .line { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 2px 12px; align-items: baseline; }
  .ed { margin-left: auto; color: var(--faint); text-decoration: none; }
  .ed:hover { color: var(--fg); }
  .title { color: var(--fg); text-decoration: none; }
  .title::before { content: '▸ '; color: var(--dim); }
  .title:hover { text-decoration: underline; }
  .meta { color: var(--dim); }
  .caption { margin-top: 4px; }
  .stats { margin-top: 2px; color: var(--dim); }
</style>
