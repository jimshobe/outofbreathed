---
// Owner-only (enforced in middleware): upload from a browser, and edit or delete recent moments.
import Base from '../layouts/Base.astro';
import { listMoments, mediaUrl } from '../lib/moments';
import { CATEGORIES } from '../lib/categories';

const recent = await listMoments(60);
---

<Base current="post">
  <main class="post">
    <form id="up" autocomplete="off">
      <div class="cmd">&gt; <b>new</b></div>
      <label class="row">
        <span>files</span>
        <input type="file" name="file" accept="image/*,video/*" multiple />
      </label>
      <label class="row"><span>or youtube</span><input type="url" name="youtube" placeholder="https://youtu.be/…" /></label>
      <div class="row">
        <span>category</span>
        <div class="cats">{CATEGORIES.map((c) => <label><input type="checkbox" name="category" value={c} checked={c === 'misc'} /> {c}</label>)}</div>
      </div>
      <label class="row food" hidden>
        <span>food</span>
        <select name="food_type"><option value="">-</option><option value="home">home</option><option value="out">out</option></select>
      </label>
      <label class="row"><span>caption</span><input type="text" name="caption" maxlength="300" /></label>
      <label class="row"><span>place</span><input type="text" name="place_name" placeholder="optional; looked up from the photo's location" /></label>
      <div class="row"><span></span><button type="submit">[ post ]</button></div>
      <pre id="log" aria-live="polite"></pre>
    </form>

    <section class="recent">
      <div class="cmd">&gt; <b>recent</b> <span>{recent.length}</span></div>
      {recent.map((m) => (
        <div class="item" data-id={m.id}>
          <a class="thumb" href={`/#m-${m.id}`}>
            {(m.thumb_key ?? (m.kind === 'photo' ? m.media_key : null)) ? <img src={mediaUrl((m.thumb_key ?? m.media_key)!)} alt="" loading="lazy" />
              : m.youtube_id ? <img src={`https://i.ytimg.com/vi/${m.youtube_id}/mqdefault.jpg`} alt="" loading="lazy" />
              : <span>{m.kind}</span>}
          </a>
          <div class="fields">
            <div class="meta">{m.place_name ? '' : 'no location in file · '}{m.kind}{m.source === 'youtube' ? ' · youtube' : ''}</div>
            <input class="caption" type="text" value={m.caption ?? ''} placeholder="caption" maxlength="300" />
            <div class="when">
              <input class="taken" type="datetime-local" step="1" value={m.taken_at.slice(0, 19)} data-offset={m.taken_at.slice(19).replace(/^\.\d+/, '')} />
              <input class="place" type="text" value={m.place_name ?? ''} placeholder="place" maxlength="80" />
            </div>
            <div class="controls">
              <span class="cats">{CATEGORIES.map((c) => <label><input type="checkbox" class="cat" value={c} checked={m.categories.includes(c)} /> {c}</label>)}</span>
              <select class="food_type" hidden={!m.categories.includes('food')}>
                <option value="">-</option>
                <option value="home" selected={m.food_type === 'home'}>home</option>
                <option value="out" selected={m.food_type === 'out'}>out</option>
              </select>
              <button class="rm" type="button">[rm]</button>
              <span class="status"></span>
            </div>
          </div>
        </div>
      ))}
    </section>
  </main>
</Base>

<script>
  // Worker types (in the global tsconfig) declare their own `Element`, which clashes with the DOM one
  // in querySelector's generic, so browser lookups go through this helper.
  const pick = <T,>(root: { querySelector(sel: string): unknown }, sel: string) => root.querySelector(sel) as T;
  const form = document.getElementById('up') as HTMLFormElement;
  const log = document.getElementById('log')!;
  const say = (line: string) => { log.textContent += line + '\n'; };
  const foodRow = form.querySelector('.food') as HTMLElement;
  const checked = (root: { querySelectorAll(sel: string): unknown }, sel: string) =>
    Array.from(root.querySelectorAll(sel) as unknown as HTMLInputElement[]).filter((i) => i.checked).map((i) => i.value);

  // Food shows the home/out choice.
  form.querySelectorAll('[name=category]').forEach((box) => box.addEventListener('change', () => {
    foodRow.hidden = !checked(form, '[name=category]').includes('food');
  }));

  type ApiResult = { error?: string; created?: boolean };
  const body = async (res: Response) => (await res.json().catch(() => ({}))) as ApiResult;

  async function post(fields: FormData, label: string) {
    for (let attempt = 1; attempt <= 3; attempt++) {
      try {
        const res = await fetch('/api/moments', { method: 'POST', body: fields });
        const result = await body(res);
        if (res.ok) return say(`  ${label} … ${result.created ? 'ok' : 'already posted'}`);
        if (res.status < 500) return say(`  ${label} … ${result.error ?? res.status}`);
      } catch { /* network: retry */ }
      if (attempt < 3) await new Promise((r) => setTimeout(r, 1500 * attempt));
    }
    say(`  ${label} … failed after 3 tries`);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const files = pick<HTMLInputElement>(form, '[name=file]').files!;
    const youtube = pick<HTMLInputElement>(form, '[name=youtube]').value.trim();
    if (!files.length && !youtube) return say('$ choose files or paste a youtube link');
    const base = new FormData(form);
    base.delete('file');
    // If a file has no date (Safari often strips it), date it "now" in this device's time zone, not UTC.
    const now = new Date(), off = -now.getTimezoneOffset();
    const pad = (n: number) => String(Math.abs(n)).padStart(2, '0');
    base.set('fallback_taken_at', `${new Date(now.getTime() + off * 60000).toISOString().slice(0, 19)}${off >= 0 ? '+' : '-'}${pad(Math.trunc(off / 60))}:${pad(off % 60)}`);
    const button = form.querySelector('button')!;
    button.disabled = true;
    say(`$ post ${files.length || 1} item${files.length === 1 || !files.length ? '' : 's'}`);
    if (!files.length) await post(base, youtube);
    for (const file of files) {
      const fd = new FormData();
      for (const [k, v] of base) if (k !== 'youtube') fd.append(k, v);
      fd.append('file', file);
      // Same file picked again → same ref → the server returns the existing moment instead of a duplicate.
      fd.append('source_ref', `web:${file.name}:${file.size}:${file.lastModified}`);
      await post(fd, file.name);
    }
    button.disabled = false;
    say('$ done. reload to see them below.');
  });

  // Inline edits on recent moments: save on change.
  (document.querySelectorAll('.item') as unknown as HTMLElement[]).forEach((item) => {
    const id = item.dataset.id!;
    const status = pick<HTMLElement>(item, '.status');
    const food = pick<HTMLSelectElement>(item, '.food_type');
    const save = async (edit: Record<string, unknown>) => {
      status.textContent = '…';
      const res = await fetch(`/api/moments/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(edit) });
      status.textContent = res.ok ? 'saved' : ((await body(res)).error ?? 'error');
      if (res.ok) setTimeout(() => (status.textContent = ''), 1500);
    };
    pick<HTMLElement>(item, '.caption').addEventListener('change', (e) => save({ caption: (e.target as HTMLInputElement).value }));
    pick<HTMLElement>(item, '.place').addEventListener('change', (e) => save({ place_name: (e.target as HTMLInputElement).value }));
    pick<HTMLElement>(item, '.taken').addEventListener('change', (e) => {
      // Keep the photo's original time-zone offset; a value with no seconds gets :00.
      const input = e.target as HTMLInputElement;
      const v = input.value.length === 16 ? input.value + ':00' : input.value;
      if (v) save({ taken_at: v + (input.dataset.offset ?? '') });
    });
    item.querySelectorAll('.cat').forEach((box) => box.addEventListener('change', (e) => {
      const cats = checked(item, '.cat');
      if (!cats.length) { (e.target as HTMLInputElement).checked = true; return; } // at least one
      food.hidden = !cats.includes('food');
      save({ categories: cats, food_type: food.value || null });
    }));
    food.addEventListener('change', () => save({ food_type: food.value || null }));
    pick<HTMLElement>(item, '.rm').addEventListener('click', async () => {
      if (!confirm('Delete this moment and its files? This cannot be undone.')) return;
      const res = await fetch(`/api/moments/${id}`, { method: 'DELETE' });
      if (res.ok) item.remove(); else status.textContent = 'delete failed';
    });
  });
</script>

<style>
  .post { max-width: 720px; margin: 0 auto; padding: 64px 20px 80px; }
  .cmd { color: var(--dim); margin: 24px 0 14px; }
  .cmd b { color: var(--fg); font-weight: 500; }
  .row { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: 12px; margin-bottom: 10px; color: var(--dim); }
  input[type='text'], input[type='url'], select {
    font: inherit; color: var(--fg); background: #000; border: 0; border-bottom: 1px solid var(--faint); padding: 6px 0; border-radius: 0; width: 100%;
  }
  select { width: auto; border: 1px solid var(--faint); padding: 4px 6px; }
  input:focus, select:focus { outline: none; border-color: var(--fg); }
  input[type='file'] { color: var(--dim); font: inherit; }
  input[type='file']::file-selector-button { font: inherit; color: var(--fg); background: #000; border: 1px solid var(--faint); padding: 4px 10px; margin-right: 12px; cursor: pointer; }
  input[type='file']::file-selector-button:hover { border-color: var(--fg); }
  input[type='checkbox'] { accent-color: var(--fg); }
  button { color: var(--fg); }
  button:hover { text-decoration: underline; }
  button:disabled { color: var(--dim); }
  #log { margin-top: 12px; color: var(--dim); font: inherit; white-space: pre-wrap; }
  .recent { margin-top: 40px; border-top: 1px solid var(--faint); }
  .item { display: grid; grid-template-columns: 88px 1fr; gap: 14px; padding: 14px 0; border-bottom: 1px solid #111; }
  .thumb { width: 88px; height: 88px; background: #0d0d0d; display: grid; place-items: center; color: var(--dim); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .meta { color: var(--dim); }
  .cats { display: flex; flex-wrap: wrap; gap: 4px 14px; color: var(--fg); }
  .cats label { white-space: nowrap; }
  .controls .cats { color: var(--dim); }
  .when { display: flex; gap: 12px; margin-top: 6px; }
  .when .taken { width: auto; color-scheme: dark; font: inherit; color: var(--fg); background: #000; border: 0; border-bottom: 1px solid var(--faint); padding: 6px 0; }
  .when .place { flex: 1; }
  .controls { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; color: var(--dim); }
  .rm { color: var(--dim); }
  .rm:hover { color: #ff6b6b; }
  .status { color: var(--dim); }
  @media (max-width: 700px) {
    .post { padding: 56px 16px 60px; }
    .row { grid-template-columns: 1fr; gap: 4px; }
    .item { grid-template-columns: 64px 1fr; }
    .thumb { width: 64px; height: 64px; }
  }
</style>
