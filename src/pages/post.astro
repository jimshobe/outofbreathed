---
// Owner-only (enforced in middleware): posting new photos and YouTube links. Editing what's already
// posted lives in /manage.
import Base from '../layouts/Base.astro';
import PostForm from '../components/PostForm.astro';
import { listSets } from '../lib/moments';

const sets = await listSets();
---

<Base current="post" homeScreen>
  <main class="post">
    <PostForm sets={sets} />
  </main>
</Base>

<style>
  .post { max-width: 720px; margin: 0 auto; padding: 64px 20px 80px; }
  @media (max-width: 700px) { .post { padding: 56px 16px 60px; } }
</style>
