---
// Owner-only (enforced in middleware): upload from a browser, and edit or delete recent moments.
import Base from '../layouts/Base.astro';
import { listMoments, listSets, setCounts, mediaUrl } from '../lib/moments';
import { listZones, shownDistanceM } from '../lib/zones';
import { pendingComments } from '../lib/comments';
import { fmtStats } from '../lib/route';
import { CATEGORIES } from '../lib/categories';

const [recent, sets, counts, zones, pending] = await Promise.all([listMoments({ limit: 60 }), listSets(), setCounts(), listZones(), pendingComments()]);
const RADII = [200, 300, 500, 1000, 2000];
const km = (m: number) => (m >= 1000 ? `${(m / 1000).toFixed(1)} km` : `${m} m`);
const covers = new Set(sets.map((s) => s.cover_id).filter(Boolean));
---

<Base current="post" homeScreen>
  <main class="post">
    <form id="up" autocomplete="off">
      <div class="cmd">&gt; <b>new</b></div>
      <label class="row">
        <span>photos</span>
        <input type="file" name="file" accept="image/*" multiple />
      </label>
      <ul id="picked" class="picked" hidden></ul>
      <p id="hint" class="hint" hidden>
        // some photos arrived without a location. on iPhone, tap <b>Options</b> at the top of the photo picker,
        turn on <b>Location</b>, and pick them again. or type a place below and they'll use that.
      </p>
      <label class="row"><span>or youtube</span><input type="url" name="youtube" placeholder="video link (upload to YouTube as Unlisted)" /></label>
      <div class="row">
        <span>category</span>
        <div class="cats">{CATEGORIES.map((c) => <label><input type="checkbox" name="category" value={c} checked={c === 'misc'} /> {c}</label>)}</div>
      </div>
      <label class="row"><span>caption</span><input type="text" name="caption" maxlength="300" /></label>
      <label class="row"><span>set</span><input type="text" name="set_title" list="set-titles" maxlength="80" placeholder="optional: new name, or pick an existing set" /></label>
      <datalist id="set-titles">{sets.map((s) => <option value={s.title} />)}</datalist>
      <label class="row set-caption" hidden><span>set caption</span><input type="text" name="set_caption" maxlength="300" placeholder="about the whole set" /></label>
      <label class="row"><span>date</span><input type="date" name="date" /></label>
      <label class="row"><span>place</span><input type="text" name="fallback_place" placeholder="e.g. Springbrook, QLD" /></label>
      <p class="note">// date and place are for youtube links, or photos missing them. photos that have their own keep them.</p>
      <div class="row"><span></span><button type="submit">[ post ]</button></div>
      <pre id="log" aria-live="polite"></pre>
    </form>

    {pending.length > 0 && (
      <section class="pending">
        <div class="cmd">&gt; <b>comments awaiting approval</b> <span>{pending.length}</span></div>
        <p class="note">// approving someone's comment also lets their future comments appear straight away.</p>
        {pending.map((c) => (
          <div class="crow" data-comment={c.id}>
            <div class="cwho">{c.avatar_url && <img src={c.avatar_url} alt="" referrerpolicy="no-referrer" />}<b>{c.first_name.toLowerCase()}</b> <span>{c.email}</span>
              · <a href={c.set_id ? `/sets/${c.set_id}` : `/#p-${c.moment_id}`}>on this {c.set_id ? 'set' : 'photo'}</a></div>
            <p class="cbody">{c.body}</p>
            <div class="cact"><button data-status="approved">[approve]</button><button data-status="rejected">[reject]</button><span class="status"></span></div>
          </div>
        ))}
      </section>
    )}

    <section class="zones">
      <div class="cmd">&gt; <b>privacy zones</b> <span>{zones.length}</span></div>
      <p class="note">// photos taken inside a zone show only its suburb, on the map and the timeline. zones are never shown to visitors.</p>
      {zones.map((z) => (
        <div class="zonerow" data-zone={z.id}>
          <input class="zlabel" type="text" value={z.label} maxlength="40" aria-label="zone label" />
          <span class="zaddr">{z.address}</span>
          <select class="zradius" aria-label="radius">{RADII.map((r) => <option value={r} selected={r === z.radius_m}>{km(r)}</option>)}</select>
          <span class="zshown">shown as {(z.area_name ?? 'the suburb').toLowerCase()} ({km(shownDistanceM(z))} away) · {z.photos} {z.photos === 1 ? 'photo' : 'photos'}</span>
          <button class="zrm" type="button">[remove]</button>
          <span class="status"></span>
        </div>
      ))}
      <form id="zone-add" class="zoneadd" autocomplete="off">
        <input name="label" type="text" placeholder="label (e.g. home)" maxlength="40" required />
        <input name="address" type="text" placeholder="address, suburb, state" maxlength="200" required />
        <select name="radius_m" aria-label="radius">{RADII.map((r) => <option value={r} selected={r === 300}>{km(r)}</option>)}</select>
        <button type="submit">[ add zone ]</button>
        <span class="status"></span>
      </form>
    </section>

    {sets.length > 0 && (
      <section class="sets">
        <div class="cmd">&gt; <b>sets</b> <span>{sets.length}</span></div>
        {sets.map((s) => (
          <div class="setrow" data-set={s.id}>
            <input class="stitle" type="text" value={s.title} maxlength="80" aria-label="set title" />
            <input class="scaption" type="text" value={s.caption ?? ''} placeholder="set caption" maxlength="300" aria-label="set caption" />
            <span class="scount"><a href={`/sets/${s.id}`}>{counts.get(s.id) ?? 0} items</a></span>
            <button class="ungroup" type="button">[ungroup]</button>
            <span class="route">
              {s.route_km != null
                ? <>⤳ {fmtStats({ km: s.route_km, secs: s.route_secs ?? null, climb_m: s.route_climb_m ?? null })} <button class="rmroute" type="button">[remove route]</button></>
                : null}
              <label class="addroute">{s.route_km != null ? '[replace route]' : '[+ route]'}<input type="file" accept=".gpx,application/gpx+xml" hidden /></label>
            </span>
            <span class="status"></span>
          </div>
        ))}
      </section>
    )}

    <section class="recent">
      <div class="cmd">&gt; <b>recent</b> <span>{recent.length}</span></div>
      {recent.map((m) => (
        <div class="item" data-id={m.id}>
          <a class="thumb" href={`/#m-${m.id}`}>
            {(m.thumb_key ?? (m.kind === 'photo' ? m.media_key : null)) ? <img src={mediaUrl((m.thumb_key ?? m.media_key)!)} alt="" loading="lazy" />
              : m.youtube_id ? <img src={`https://i.ytimg.com/vi/${m.youtube_id}/mqdefault.jpg`} alt="" loading="lazy" />
              : <span>{m.kind}</span>}
          </a>
          <div class="fields">
            <div class="meta">{m.place_name ? '' : 'no location · '}{m.kind}{m.source === 'youtube' ? ' · youtube' : ''}</div>
            <input class="caption" type="text" value={m.caption ?? ''} placeholder="caption" maxlength="300" />
            <div class="when">
              <input class="taken" type="datetime-local" step="1" value={m.taken_at.slice(0, 19)} data-offset={m.taken_at.slice(19).replace(/^\.\d+/, '')} />
              <input class="place" type="text" value={m.place_name ?? ''} placeholder="place" maxlength="80" />
            </div>
            <div class="controls">
              <span class="cats">{CATEGORIES.map((c) => <label><input type="checkbox" class="cat" value={c} checked={m.categories.includes(c)} /> {c}</label>)}</span>
              <select class="setsel" aria-label="set">
                <option value="">no set</option>
                {sets.map((s) => <option value={s.id} selected={s.id === m.set_id}>{s.title}</option>)}
              </select>
              {m.set_id && m.media_key && (
                <button class="cover" type="button" data-set={m.set_id} aria-pressed={covers.has(m.id) ? 'true' : 'false'}
                  title="use as the set's cover">{covers.has(m.id) ? '★ cover' : '☆ cover'}</button>
              )}
              <button class="rm" type="button">[rm]</button>
              <span class="status"></span>
            </div>
          </div>
        </div>
      ))}
    </section>
  </main>
</Base>

<script>
  import { readJpegMeta } from '../lib/exif';

  // Worker types (in the global tsconfig) declare their own `Element`, which clashes with the DOM one
  // in querySelector's generic, so browser lookups go through this helper.
  const pick = <T,>(root: { querySelector(sel: string): unknown }, sel: string) => root.querySelector(sel) as T;
  const form = document.getElementById('up') as HTMLFormElement;
  const log = document.getElementById('log')!;
  const say = (line: string) => { log.textContent += line + '\n'; };
  const checked = (root: { querySelectorAll(sel: string): unknown }, sel: string) =>
    Array.from(root.querySelectorAll(sel) as unknown as HTMLInputElement[]).filter((i) => i.checked).map((i) => i.value);


  // Before uploading, show each picked file with the date and location found in it, so photos that
  // Safari stripped can be fixed (re-picked with Options → Location) before they're posted.
  const fileInput = pick<HTMLInputElement>(form, '[name=file]');
  const picked = document.getElementById('picked') as HTMLUListElement;
  const hint = document.getElementById('hint')!;
  let previews: string[] = [];
  const day = (iso: string) => new Date(`${iso.slice(0, 10)}T00:00:00Z`).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).toLowerCase();

  async function describe(file: File) {
    const isJpeg = file.type === 'image/jpeg' || /\.jpe?g$/i.test(file.name);
    if (file.type.startsWith('video/')) return { text: 'videos go on youtube', missing: true };
    if (!isJpeg) return { text: 'date and place read on upload', missing: false };
    // EXIF sits at the start of the file; no need to read the whole photo.
    const meta = readJpegMeta(new Uint8Array(await file.slice(0, 512 * 1024).arrayBuffer()));
    const when = meta.takenAt ? day(meta.takenAt) : 'no date';
    const where = meta.lat != null ? 'location ✓' : 'no location';
    return { text: `${when} · ${where}`, missing: meta.lat == null };
  }

  fileInput.addEventListener('change', async () => {
    previews.forEach((u) => URL.revokeObjectURL(u));
    previews = [];
    let anyMissing = false;
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
    const files = Array.from(fileInput.files ?? []);
    picked.innerHTML = files.map((file) => {
      const url = URL.createObjectURL(file);
      previews.push(url);
      const media = file.type.startsWith('video/') ? `<video src="${url}" muted></video>` : `<img src="${url}" alt="">`;
      return `<li>${media}<span>${esc(file.name)}</span><span class="info">…</span><span class="st"></span></li>`;
    }).join('');
    const rows = Array.from(picked.children) as unknown as HTMLElement[];
    for (const [i, file] of files.entries()) {
      const d = await describe(file);
      pick<HTMLElement>(rows[i], '.info').textContent = d.text;
      if (d.missing) { rows[i].classList.add('missing'); anyMissing = true; }
    }
    picked.hidden = !picked.children.length;
    hint.hidden = !anyMissing;
  });

  type ApiResult = { error?: string; created?: boolean };
  const body = async (res: Response) => (await res.json().catch(() => ({}))) as ApiResult;

  /** Posts one item, retrying network failures. Returns true if it's now on the site. */
  async function post(fields: FormData, label: string, mark?: (s: string) => void): Promise<boolean> {
    const done = (msg: string, ok: boolean) => { say(`  ${label} … ${msg}`); mark?.(ok ? '✓' : '✗'); return ok; };
    for (let attempt = 1; attempt <= 3; attempt++) {
      mark?.(attempt === 1 ? '…' : `retry ${attempt}`);
      try {
        const res = await fetch('/api/moments', { method: 'POST', body: fields });
        const result = await body(res);
        if (res.ok) return done(result.created ? 'ok' : 'already posted', true);
        if (res.status < 500) return done(result.error ?? String(res.status), false);
      } catch { /* network: retry */ }
      if (attempt < 3) await new Promise((r) => setTimeout(r, 1500 * attempt));
    }
    return done('failed after 3 tries; post again to retry', false);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const files = fileInput.files!;
    const youtube = pick<HTMLInputElement>(form, '[name=youtube]').value.trim();
    if (!files.length && !youtube) return say('$ choose files or paste a youtube link');
    const base = new FormData(form);
    base.delete('file');
    // Items with no date of their own (YouTube links, photos Safari stripped) get the typed date,
    // or else "now" in this device's time zone (not UTC, which can land on the wrong day).
    const typedDate = String(base.get('date') ?? '');
    base.delete('date');
    const now = new Date(), off = -now.getTimezoneOffset();
    const pad = (n: number) => String(Math.abs(n)).padStart(2, '0');
    const nowLocal = `${new Date(now.getTime() + off * 60000).toISOString().slice(0, 19)}${off >= 0 ? '+' : '-'}${pad(Math.trunc(off / 60))}:${pad(off % 60)}`;
    base.set('fallback_taken_at', typedDate ? `${typedDate}T12:00:00` : nowLocal);
    const setTitle = String(base.get('set_title') ?? '').trim();
    const setCaption = String(base.get('set_caption') ?? '').trim();
    base.delete('set_title');
    base.delete('set_caption');
    const button = form.querySelector('button')!;
    button.disabled = true;
    if (setTitle) {
      const res = await fetch('/api/sets', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title: setTitle, caption: setCaption }) });
      const r = (await res.json().catch(() => ({}))) as { id?: string; created?: boolean; error?: string };
      if (!res.ok || !r.id) { say(`$ set "${setTitle}": ${r.error ?? res.status}`); button.disabled = false; return; }
      base.set('set_id', r.id);
      say(`$ set "${setTitle}" (${r.created ? 'new' : 'existing'})`);
    }
    say(`$ post ${files.length || 1} item${files.length === 1 || !files.length ? '' : 's'}`);
    let posted = 0;
    if (!files.length && (await post(base, youtube))) posted++;
    const rows = Array.from(picked.children) as unknown as HTMLElement[];
    for (const [i, file] of Array.from(files).entries()) {
      const fd = new FormData();
      for (const [k, v] of base) if (k !== 'youtube') fd.append(k, v);
      fd.append('file', file);
      // Same file picked again → same ref → the server returns the existing moment instead of a duplicate.
      fd.append('source_ref', `web:${file.name}:${file.size}:${file.lastModified}`);
      const st = rows[i]?.querySelector('.st');
      if (await post(fd, file.name, (m) => { if (st) st.textContent = m; })) posted++;
    }
    button.disabled = false;
    if (posted) {
      say('$ done');
      setTimeout(() => location.reload(), 1200);
    }
  });

  // A new set name shows the set-caption field; an existing set's caption is edited under "sets".
  const setTitleInput = pick<HTMLInputElement>(form, '[name=set_title]');
  const existingTitles = new Set(Array.from(document.querySelectorAll('#set-titles option') as unknown as HTMLOptionElement[]).map((o) => o.value.toLowerCase()));
  setTitleInput.addEventListener('input', () => {
    const t = setTitleInput.value.trim().toLowerCase();
    pick<HTMLElement>(form, '.set-caption').hidden = !t || existingTitles.has(t);
  });

  // Comment moderation.
  (document.querySelectorAll('.crow') as unknown as HTMLElement[]).forEach((row) => {
    row.querySelectorAll('[data-status]').forEach((b) => b.addEventListener('click', async (e) => {
      const status = (e.target as HTMLElement).dataset.status;
      const res = await fetch(`/api/comments/${row.dataset.comment}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) });
      if (res.ok) row.remove(); else pick<HTMLElement>(row, '.status').textContent = (await body(res)).error ?? 'error';
    }));
  });

  // Privacy zones: add (looked up from the address), relabel, change radius, remove.
  const zoneForm = document.getElementById('zone-add') as HTMLFormElement;
  zoneForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = pick<HTMLElement>(zoneForm, '.status');
    const fd = new FormData(zoneForm);
    status.textContent = 'looking up address…';
    const res = await fetch('/api/zones', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ label: fd.get('label'), address: fd.get('address'), radius_m: Number(fd.get('radius_m')) }) });
    if (res.ok) location.reload(); else status.textContent = (await body(res)).error ?? 'error';
  });
  (document.querySelectorAll('.zonerow') as unknown as HTMLElement[]).forEach((row) => {
    const id = row.dataset.zone!;
    const status = pick<HTMLElement>(row, '.status');
    const patch = async (edit: Record<string, unknown>, reload = false) => {
      status.textContent = '…';
      const res = await fetch(`/api/zones/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(edit) });
      if (res.ok && reload) return location.reload();
      status.textContent = res.ok ? 'saved' : ((await body(res)).error ?? 'error');
    };
    pick<HTMLElement>(row, '.zlabel').addEventListener('change', (e) => patch({ label: (e.target as HTMLInputElement).value }));
    // A new radius moves photos in or out of the zone, so reload to show the new count.
    pick<HTMLElement>(row, '.zradius').addEventListener('change', (e) => patch({ radius_m: Number((e.target as HTMLSelectElement).value) }, true));
    pick<HTMLElement>(row, '.zrm').addEventListener('click', async () => {
      if (!confirm('Remove this zone? Photos inside it will show their exact location again.')) return;
      const res = await fetch(`/api/zones/${id}`, { method: 'DELETE' });
      if (res.ok) location.reload(); else status.textContent = 'remove failed';
    });
  });

  // Set management: rename, caption, ungroup.
  (document.querySelectorAll('.setrow') as unknown as HTMLElement[]).forEach((row) => {
    const id = row.dataset.set!;
    const status = pick<HTMLElement>(row, '.status');
    const save = async (edit: Record<string, unknown>) => {
      status.textContent = '…';
      const res = await fetch(`/api/sets/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(edit) });
      status.textContent = res.ok ? 'saved' : ((await body(res)).error ?? 'error');
      if (res.ok) setTimeout(() => (status.textContent = ''), 1500);
    };
    pick<HTMLElement>(row, '.stitle').addEventListener('change', (e) => save({ title: (e.target as HTMLInputElement).value }));
    pick<HTMLElement>(row, '.scaption').addEventListener('change', (e) => save({ caption: (e.target as HTMLInputElement).value }));
    // Ride route: upload a GPX; the server trims it out of privacy zones and works out the stats.
    pick<HTMLInputElement>(row, '.addroute input').addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      status.textContent = 'reading route…';
      const fd = new FormData();
      fd.append('file', file);
      const res = await fetch(`/api/sets/${id}/route`, { method: 'POST', body: fd });
      if (res.ok) location.reload(); else status.textContent = (await body(res)).error ?? 'error';
    });
    pick<HTMLElement>(row, '.rmroute')?.addEventListener('click', async () => {
      if (!confirm('Remove this ride route?')) return;
      const res = await fetch(`/api/sets/${id}/route`, { method: 'DELETE' });
      if (res.ok) location.reload(); else status.textContent = 'remove failed';
    });
    pick<HTMLElement>(row, '.ungroup').addEventListener('click', async () => {
      if (!confirm('Ungroup this set? Its photos stay on the timeline.')) return;
      const res = await fetch(`/api/sets/${id}`, { method: 'DELETE' });
      if (res.ok) location.reload(); else status.textContent = 'ungroup failed';
    });
  });

  // Inline edits on recent moments: save on change.
  (document.querySelectorAll('.item') as unknown as HTMLElement[]).forEach((item) => {
    const id = item.dataset.id!;
    const status = pick<HTMLElement>(item, '.status');
    const save = async (edit: Record<string, unknown>) => {
      status.textContent = '…';
      const res = await fetch(`/api/moments/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(edit) });
      status.textContent = res.ok ? 'saved' : ((await body(res)).error ?? 'error');
      if (res.ok) setTimeout(() => (status.textContent = ''), 1500);
    };
    pick<HTMLElement>(item, '.caption').addEventListener('change', (e) => save({ caption: (e.target as HTMLInputElement).value }));
    pick<HTMLElement>(item, '.place').addEventListener('change', (e) => save({ place_name: (e.target as HTMLInputElement).value }));
    pick<HTMLElement>(item, '.taken').addEventListener('change', (e) => {
      // Keep the photo's original time-zone offset; a value with no seconds gets :00.
      const input = e.target as HTMLInputElement;
      const v = input.value.length === 16 ? input.value + ':00' : input.value;
      if (v) save({ taken_at: v + (input.dataset.offset ?? '') });
    });
    item.querySelectorAll('.cat').forEach((box) => box.addEventListener('change', (e) => {
      const cats = checked(item, '.cat');
      if (!cats.length) { (e.target as HTMLInputElement).checked = true; return; } // at least one
      save({ categories: cats });
    }));
    pick<HTMLElement>(item, '.setsel').addEventListener('change', (e) => save({ set_id: (e.target as HTMLSelectElement).value || null }));
    pick<HTMLElement>(item, '.cover')?.addEventListener('click', async (e) => {
      const btn = e.target as HTMLButtonElement;
      const res = await fetch(`/api/sets/${btn.dataset.set}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cover_id: id }) });
      if (!res.ok) { status.textContent = (await body(res)).error ?? 'error'; return; }
      // Only one cover per set: reset the other stars in the same set.
      (document.querySelectorAll(`.cover[data-set="${btn.dataset.set}"]`) as unknown as HTMLButtonElement[]).forEach((b) => { b.textContent = '☆ cover'; b.setAttribute('aria-pressed', 'false'); });
      btn.textContent = '★ cover';
      btn.setAttribute('aria-pressed', 'true');
    });
    pick<HTMLElement>(item, '.rm').addEventListener('click', async () => {
      if (!confirm('Delete this moment and its files? This cannot be undone.')) return;
      const res = await fetch(`/api/moments/${id}`, { method: 'DELETE' });
      if (res.ok) item.remove(); else status.textContent = 'delete failed';
    });
  });
</script>

<style>
  .post { max-width: 720px; margin: 0 auto; padding: 64px 20px 80px; }
  .cmd { color: var(--dim); margin: 24px 0 14px; }
  .cmd b { color: var(--fg); font-weight: 500; }
  .row { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: 12px; margin-bottom: 10px; color: var(--dim); }
  input[type='text'], input[type='url'], select {
    font: inherit; color: var(--fg); background: #000; border: 0; border-bottom: 1px solid var(--faint); padding: 6px 0; border-radius: 0; width: 100%;
  }
  select { width: auto; border: 1px solid var(--faint); padding: 4px 6px; }
  input:focus, select:focus { outline: none; border-color: var(--fg); }
  input[type='file'] { color: var(--dim); font: inherit; }
  input[type='file']::file-selector-button { font: inherit; color: var(--fg); background: #000; border: 1px solid var(--faint); padding: 4px 10px; margin-right: 12px; cursor: pointer; }
  input[type='file']::file-selector-button:hover { border-color: var(--fg); }
  input[type='checkbox'] { accent-color: var(--fg); }
  button { color: var(--fg); }
  button:hover { text-decoration: underline; }
  button:disabled { color: var(--dim); }
  #log { margin-top: 12px; color: var(--dim); font: inherit; white-space: pre-wrap; }
  /* Preview rows are created by script, so they lack Astro's scoped-style attribute: style them via :global. */
  .picked { list-style: none; padding: 0; margin: 4px 0 14px; display: grid; gap: 6px; }
  .picked :global(li) { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto auto; gap: 10px; align-items: center; color: var(--fg); }
