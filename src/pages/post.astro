---
// Owner-only (enforced in middleware): upload from a browser, and edit or delete recent moments.
import Base from '../layouts/Base.astro';
import PostForm from '../components/PostForm.astro';
import { listMoments, listSets, setPlaces, mediaUrl, fmtDay } from '../lib/moments';
import { listZones, shownDistanceM } from '../lib/zones';
import { pendingComments } from '../lib/comments';
import { fmtStats } from '../lib/route';
import { CATEGORIES } from '../lib/categories';
import { listPlaceNames, listPlaceLinks } from '../lib/place-links';
import { isVenue, splitVenue } from '../lib/maps-link';

// "recent" shows 60 at a time; ?older=<taken_at> pages back.
const older = Astro.url.searchParams.get('older') ?? undefined;
const PAGE = 60;
const [recent, sets, places, zones, pending, placeNames, placeLinks] = await Promise.all([
  listMoments({ limit: PAGE, before: older }), listSets(), setPlaces(), listZones(), pendingComments(), listPlaceNames(), listPlaceLinks(),
]);
const setTitle = new Map(sets.map((s) => [s.id, s.title]));
const fmtWhen = fmtDay;
const RADII = [200, 300, 500, 1000, 2000];
const km = (m: number) => (m >= 1000 ? `${(m / 1000).toFixed(1)} km` : `${m} m`);
const covers = new Set(sets.map((s) => s.cover_id).filter(Boolean));
---

<Base current="post" homeScreen>
  <main class="post">
    <nav class="tabs" aria-label="post page sections">
      <button data-tab="post">post</button>
      <button data-tab="recent">recent</button>
      <button data-tab="sets">sets</button>
      <button data-tab="comments">comments{pending.length > 0 && <b class="badge">{pending.length}</b>}</button>
      <button data-tab="places">places</button>
      <button data-tab="zones">zones</button>
    </nav>

    <section data-panel="post">
      <PostForm sets={sets} />
    </section>

    <section data-panel="recent" class="recent" hidden>
      <div class="rhead">
        <span class="cmd">&gt; <b>recent</b> <span>{older ? `before ${fmtWhen(older)}` : 'latest'}</span></span>
        <button type="button" class="selmode">[select]</button>
      </div>
      {recent.map((m) => (
        <div class="item" data-id={m.id}>
          <div class="sum">
            <input type="checkbox" class="sel" aria-label="select" />
            <span class="thumb">
              {(m.thumb_key ?? (m.kind === 'photo' ? m.media_key : null)) ? <img src={mediaUrl((m.thumb_key ?? m.media_key)!)} alt="" loading="lazy" />
                : m.youtube_id ? <img src={`https://i.ytimg.com/vi/${m.youtube_id}/mqdefault.jpg`} alt="" loading="lazy" />
                : <span>{m.kind}</span>}
            </span>
            <button type="button" class="open" aria-expanded="false">
              <span class="l1">{fmtWhen(m.taken_at)} · <span class="pn">{m.place_name?.toLowerCase() ?? 'no location'}</span>{m.source === 'youtube' ? ' · ▶' : ''}</span>
              <span class="l2 cap">{m.caption ?? ''}</span>
              <span class="l3">{[...m.categories, ...(m.set_id ? [`▸ ${setTitle.get(m.set_id)?.toLowerCase() ?? 'set'}`] : [])].join(' · ')}</span>
            </button>
          </div>
          <div class="fields" hidden>
            <input class="caption" type="text" value={m.caption ?? ''} placeholder="caption" maxlength="300" />
            <div class="when">
              <input class="taken" type="datetime-local" step="1" value={m.taken_at.slice(0, 19)} data-offset={m.taken_at.slice(19).replace(/^\.\d+/, '')} />
              <input class="place" type="text" value={m.place_name ?? ''} placeholder="place" maxlength="80" />
            </div>
            <div class="controls">
              <span class="cats">{CATEGORIES.map((c) => <label><input type="checkbox" class="cat" value={c} checked={m.categories.includes(c)} /> {c}</label>)}</span>
              <select class="setsel" aria-label="set">
                <option value="">no set</option>
                {sets.map((s) => <option value={s.id} selected={s.id === m.set_id}>{s.title}</option>)}
              </select>
              {m.set_id && m.media_key && (
                <button class="cover" type="button" data-set={m.set_id} aria-pressed={covers.has(m.id) ? 'true' : 'false'}
                  title="use as the set's cover">{covers.has(m.id) ? '★ cover' : '☆ cover'}</button>
              )}
              <a class="view" href={`/#p-${m.id}`}>[view]</a>
              <button class="rm" type="button">[delete]</button>
              <span class="status"></span>
            </div>
          </div>
        </div>
      ))}
      {recent.length === 0 && <p class="note">// nothing here yet</p>}
      <div class="pager">
        {older && <a href="/post#recent">[newest]</a>}
        {recent.length === PAGE && <a href={`/post?older=${encodeURIComponent(recent[recent.length - 1].taken_at)}#recent`}>[load older ↓]</a>}
      </div>

      <div class="bulk" hidden>
        <span class="count">0 selected</span>
        <span class="grp">
          <select class="bset" aria-label="set for selected">
            <option value="">— set —</option>
            <option value="__none">no set (take out)</option>
            {sets.map((s) => <option value={s.id}>{s.title}</option>)}
          </select>
          <button type="button" data-bulk="set">[apply]</button>
        </span>
        <span class="grp">
          <select class="btag" aria-label="tag for selected">{CATEGORIES.map((c) => <option value={c}>{c}</option>)}</select>
          <button type="button" data-bulk="tag-add">[+ tag]</button>
          <button type="button" data-bulk="tag-remove">[− tag]</button>
        </span>
        <span class="grp">
          <input class="bplace" type="text" list="place-names" maxlength="120" placeholder="place, e.g. STABLE, Tugun" aria-label="place for selected" />
          <button type="button" data-bulk="place">[rename]</button>
        </span>
        <button type="button" data-bulk="delete" class="danger">[delete]</button>
        <button type="button" class="bclear">[done]</button>
        <span class="bstatus"></span>
      </div>
    </section>

    <section data-panel="sets" class="sets" hidden>
      <div class="cmd">&gt; <b>sets</b> <span>{sets.length}</span></div>
      <p class="note">// make a set from the post tab, or select photos in recent and choose a set.</p>
        {sets.map((s) => (
          <div class="setrow" data-set={s.id}>
            <input class="stitle" type="text" value={s.title} maxlength="80" aria-label="set title" />
            <input class="scaption" type="text" value={s.caption ?? ''} placeholder="set caption" maxlength="300" aria-label="set caption" />
            <span class="scount"><a href={`/sets/${s.id}`}>[view]</a></span>
            <button class="ungroup" type="button">[ungroup]</button>
            {(() => {
              const p = places.get(s.id);
              if (!p) return null;
              const one = p.names.length === 1 ? p.names[0] : '';
              return (
                <label class="splace"><span>place</span>
                  <input class="splacein" type="text" list={`sp-${s.id}`} value={one} maxlength="120"
                    placeholder={p.names.length > 1 ? `mixed: ${p.names.join(' / ')}` : 'place, e.g. STABLE, Tugun'}
                    data-ids={p.ids.join(',')} data-lat={p.lat ?? ''} data-lng={p.lng ?? ''} aria-label="place for every photo in this set" />
                  <datalist id={`sp-${s.id}`}>{placeNames.map((n) => <option value={n.name} />)}</datalist>
                </label>
              );
            })()}
            <span class="route">
              {s.route_km != null
                ? <>⤳ {fmtStats({ km: s.route_km, secs: s.route_secs ?? null, climb_m: s.route_climb_m ?? null })} <button class="rmroute" type="button">[remove route]</button></>
                : null}
              <label class="addroute">{s.route_km != null ? '[replace route]' : '[+ route]'}<input type="file" accept=".gpx,application/gpx+xml" hidden /></label>
            </span>
            <span class="status"></span>
          </div>
        ))}
    </section>

    <section data-panel="comments" class="pending" hidden>
      <div class="cmd">&gt; <b>comments awaiting approval</b> <span>{pending.length}</span></div>
      <p class="note">{pending.length ? "// approving someone's comment also lets their future comments appear straight away." : '// nothing waiting.'}</p>
        {pending.map((c) => (
          <div class="crow" data-comment={c.id}>
            <div class="cwho">{c.avatar_url && <img src={c.avatar_url} alt="" referrerpolicy="no-referrer" />}<b>{c.first_name.toLowerCase()}</b> <span>{c.email}</span>
              · <a href={c.set_id ? `/sets/${c.set_id}` : `/#p-${c.moment_id}`}>on this {c.set_id ? 'set' : 'photo'}</a></div>
            <p class="cbody">{c.body}</p>
            <div class="cact"><button data-status="approved">[approve]</button><button data-status="rejected">[reject]</button><span class="status"></span></div>
          </div>
        ))}
    </section>

    <section data-panel="places" class="places" hidden>
      <div class="cmd">&gt; <b>places</b></div>
      <p class="note">// where each place's ↗ goes. leave blank for automatic (a google maps search for a venue, the wikipedia article for its suburb or the place). paste a link to fix one. to fix a name, rename its photos in recent → [select].</p>
      <datalist id="place-names">{placeNames.map((p) => <option value={p.name} />)}</datalist>
      {placeNames.length === 0 && <p class="note">// no named places yet</p>}
      {placeNames.map((p) => {
        const venue = isVenue(p.name, p.zoned), o = placeLinks.get(p.name);
        return (
          <div class="placerow" data-name={p.name}>
            <span class="pname">{p.name.toLowerCase()}</span>
            {venue && <label class="plink"><span>{splitVenue(p.name).venue.toLowerCase()} ↗</span>
              <input class="pg" type="url" value={o?.gmaps_url ?? ''} placeholder="automatic: google maps search" aria-label="google maps link" /></label>}
            <label class="plink"><span>{(venue ? splitVenue(p.name).area : p.name).toLowerCase()} ↗</span>
              <input class="pw" type="url" value={o?.wiki_url ?? ''} placeholder="automatic: wikipedia" aria-label="wikipedia link" /></label>
            <span class="status"></span>
          </div>
        );
      })}
    </section>

    <section data-panel="zones" class="zones" hidden>
      <div class="cmd">&gt; <b>privacy zones</b> <span>{zones.length}</span></div>
      <p class="note">// photos taken inside a zone show only its suburb, on the map and the timeline. zones are never shown to visitors.</p>
      {zones.map((z) => (
        <div class="zonerow" data-zone={z.id}>
          <input class="zlabel" type="text" value={z.label} maxlength="40" aria-label="zone label" />
          <span class="zaddr">{z.address}</span>
          <select class="zradius" aria-label="radius">{RADII.map((r) => <option value={r} selected={r === z.radius_m}>{km(r)}</option>)}</select>
          <span class="zshown">shown as {(z.area_name ?? 'the suburb').toLowerCase()} ({km(shownDistanceM(z))} away) · {z.photos} {z.photos === 1 ? 'photo' : 'photos'}</span>
          <button class="zrm" type="button">[remove]</button>
          <span class="status"></span>
        </div>
      ))}
      <form id="zone-add" class="zoneadd" autocomplete="off">
        <input name="label" type="text" placeholder="label (e.g. home)" maxlength="40" required />
        <input name="address" type="text" placeholder="address, suburb, state" maxlength="200" required />
        <select name="radius_m" aria-label="radius">{RADII.map((r) => <option value={r} selected={r === 300}>{km(r)}</option>)}</select>
        <button type="submit">[ add zone ]</button>
        <span class="status"></span>
      </form>
    </section>
  </main>
</Base>

<script>
  import '../scripts/post-form';

  // Worker types (in the global tsconfig) declare their own `Element`, which clashes with the DOM one
  // in querySelector's generic, so browser lookups go through this helper.
  const pick = <T,>(root: { querySelector(sel: string): unknown }, sel: string) => root.querySelector(sel) as T;
  const checked = (root: { querySelectorAll(sel: string): unknown }, sel: string) =>
    Array.from(root.querySelectorAll(sel) as unknown as HTMLInputElement[]).filter((i) => i.checked).map((i) => i.value);

  type ApiResult = { error?: string; created?: boolean };
  const body = async (res: Response) => (await res.json().catch(() => ({}))) as ApiResult;

  // ---- tabs: one section at a time; the open tab lives in the URL (#recent) so reloads come back to it ----
  const tabs = Array.from(document.querySelectorAll('.tabs [data-tab]') as unknown as HTMLElement[]);
  const panels = Array.from(document.querySelectorAll('[data-panel]') as unknown as HTMLElement[]);
  function showTab(name: string) {
    if (!panels.some((p) => p.dataset.panel === name)) name = 'post';
    panels.forEach((p) => { p.hidden = p.dataset.panel !== name; });
    tabs.forEach((t) => t.setAttribute('aria-current', t.dataset.tab === name ? 'page' : 'false'));
  }
  tabs.forEach((t) => t.addEventListener('click', () => {
    history.replaceState(null, '', `${location.pathname}${location.search}#${t.dataset.tab}`);
    showTab(t.dataset.tab!);
  }));
  showTab(location.hash.slice(1));

  // ---- recent: tap a row to open its edit controls; [select] for bulk changes ----
  const recentPanel = pick<HTMLElement>(document, '[data-panel=recent]');
  const bulkBar = pick<HTMLElement>(recentPanel, '.bulk');
  const selected = () => Array.from(recentPanel.querySelectorAll('.sel') as unknown as HTMLInputElement[]).filter((b) => b.checked);
  const updateBulk = () => {
    const n = selected().length;
    pick<HTMLElement>(bulkBar, '.count').textContent = `${n} selected`;
  };
  recentPanel.addEventListener('click', (e) => {
    const open = (e.target as HTMLElement).closest('.open') as HTMLElement | null;
    if (!open) return;
    const item = open.closest('.item') as HTMLElement;
    if (recentPanel.classList.contains('selecting')) {
      // In select mode a tap selects instead of opening.
      const box = pick<HTMLInputElement>(item, '.sel');
      box.checked = !box.checked;
      return updateBulk();
    }
    const fields = pick<HTMLElement>(item, '.fields');
    fields.hidden = !fields.hidden;
    open.setAttribute('aria-expanded', String(!fields.hidden));
  });
  recentPanel.addEventListener('change', (e) => { if ((e.target as HTMLElement).classList.contains('sel')) updateBulk(); });
  const setSelecting = (on: boolean) => {
    recentPanel.classList.toggle('selecting', on);
    bulkBar.hidden = !on;
    if (!on) selected().forEach((b) => { b.checked = false; });
    updateBulk();
  };
  pick<HTMLElement>(recentPanel, '.selmode').addEventListener('click', () => setSelecting(!recentPanel.classList.contains('selecting')));
  pick<HTMLElement>(bulkBar, '.bclear').addEventListener('click', () => setSelecting(false));

  bulkBar.querySelectorAll('[data-bulk]').forEach((btn) => btn.addEventListener('click', async () => {
    const action = (btn as HTMLElement).dataset.bulk!;
    const ids = selected().map((b) => (b.closest('.item') as HTMLElement).dataset.id!);
    const st = pick<HTMLElement>(bulkBar, '.bstatus');
    if (!ids.length) { st.textContent = 'select some photos first'; return; }
    const payload: Record<string, unknown> = { ids, action };
    if (action === 'set') {
      const v = pick<HTMLSelectElement>(bulkBar, '.bset').value;
      if (!v) { st.textContent = 'choose a set'; return; }
      payload.set_id = v === '__none' ? null : v;
    }
    if (action.startsWith('tag')) payload.category = pick<HTMLSelectElement>(bulkBar, '.btag').value;
    if (action === 'place') {
      payload.place_name = pick<HTMLInputElement>(bulkBar, '.bplace').value.trim();
      if (!payload.place_name) { st.textContent = 'type a place'; return; }
    }
    if (action === 'delete' && !confirm(`Delete ${ids.length} photo${ids.length === 1 ? '' : 's'} and their files? This cannot be undone.`)) return;
    st.textContent = '…';
    const res = await fetch('/api/moments/bulk', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    if (res.ok) location.reload(); else st.textContent = (await body(res)).error ?? 'error';
  }));

  // ---- places: link overrides save as you leave a field ----
  document.querySelectorAll('.placerow').forEach((row) => {
    const r = row as unknown as HTMLElement, st = pick<HTMLElement>(r, '.status');
    const save = async () => {
      st.textContent = '…';
      const g = r.querySelector('.pg') as unknown as HTMLInputElement | null;
      const res = await fetch('/api/place-links', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: r.dataset.name, gmaps_url: g?.value ?? '', wiki_url: pick<HTMLInputElement>(r, '.pw').value }),
      });
      st.textContent = res.ok ? 'saved' : (await body(res)).error ?? 'error';
    };
    r.querySelectorAll('input').forEach((i) => i.addEventListener('change', save));
  });

  // /post?set=<id>#sets (the [edit] link on a set page): bring that set into view.
  const want = new URLSearchParams(location.search).get('set');
  const wantRow = want ? (document.querySelector(`.setrow[data-set="${CSS.escape(want)}"]`) as unknown as HTMLElement | null) : null;
  if (wantRow) { wantRow.classList.add('focus'); wantRow.scrollIntoView({ block: 'center' }); }

  // Comment moderation.
  (document.querySelectorAll('.crow') as unknown as HTMLElement[]).forEach((row) => {
    row.querySelectorAll('[data-status]').forEach((b) => b.addEventListener('click', async (e) => {
      const status = (e.target as HTMLElement).dataset.status;
      const res = await fetch(`/api/comments/${row.dataset.comment}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) });
      if (res.ok) row.remove(); else pick<HTMLElement>(row, '.status').textContent = (await body(res)).error ?? 'error';
    }));
  });

  // Privacy zones: add (looked up from the address), relabel, change radius, remove.
  const zoneForm = document.getElementById('zone-add') as HTMLFormElement;
  zoneForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = pick<HTMLElement>(zoneForm, '.status');
    const fd = new FormData(zoneForm);
    status.textContent = 'looking up address…';
    const res = await fetch('/api/zones', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ label: fd.get('label'), address: fd.get('address'), radius_m: Number(fd.get('radius_m')) }) });
    if (res.ok) location.reload(); else status.textContent = (await body(res)).error ?? 'error';
  });
  (document.querySelectorAll('.zonerow') as unknown as HTMLElement[]).forEach((row) => {
    const id = row.dataset.zone!;
    const status = pick<HTMLElement>(row, '.status');
    const patch = async (edit: Record<string, unknown>, reload = false) => {
      status.textContent = '…';
      const res = await fetch(`/api/zones/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(edit) });
      if (res.ok && reload) return location.reload();
      status.textContent = res.ok ? 'saved' : ((await body(res)).error ?? 'error');
    };
    pick<HTMLElement>(row, '.zlabel').addEventListener('change', (e) => patch({ label: (e.target as HTMLInputElement).value }));
    // A new radius moves photos in or out of the zone, so reload to show the new count.
    pick<HTMLElement>(row, '.zradius').addEventListener('change', (e) => patch({ radius_m: Number((e.target as HTMLSelectElement).value) }, true));
    pick<HTMLElement>(row, '.zrm').addEventListener('click', async () => {
      if (!confirm('Remove this zone? Photos inside it will show their exact location again.')) return;
      const res = await fetch(`/api/zones/${id}`, { method: 'DELETE' });
      if (res.ok) location.reload(); else status.textContent = 'remove failed';
    });
  });

  // Set management: rename, caption, ungroup.
  (document.querySelectorAll('.setrow') as unknown as HTMLElement[]).forEach((row) => {
    const id = row.dataset.set!;
    const status = pick<HTMLElement>(row, '.status');
    const save = async (edit: Record<string, unknown>) => {
      status.textContent = '…';
      const res = await fetch(`/api/sets/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(edit) });
      status.textContent = res.ok ? 'saved' : ((await body(res)).error ?? 'error');
      if (res.ok) setTimeout(() => (status.textContent = ''), 1500);
    };
    pick<HTMLElement>(row, '.stitle').addEventListener('change', (e) => save({ title: (e.target as HTMLInputElement).value }));
    pick<HTMLElement>(row, '.scaption').addEventListener('change', (e) => save({ caption: (e.target as HTMLInputElement).value }));
    // Place: renames every photo in the set. Suggestions are the venues near the set's first GPS photo.
    const placeIn = row.querySelector('.splacein') as unknown as HTMLInputElement | null;
    if (placeIn) {
      let suggested = false;
      placeIn.addEventListener('focus', async () => {
        if (suggested || !placeIn.dataset.lat) return;
        suggested = true;
        const res = await fetch(`/api/places/nearby?lat=${placeIn.dataset.lat}&lng=${placeIn.dataset.lng}`);
        const r = res.ok ? ((await res.json()) as { choices?: string[] }) : {};
        const list = pick<HTMLElement>(row, 'datalist');
        // Nearby venues first, then names used elsewhere.
        list.innerHTML = (r.choices ?? []).map((c) => `<option value="${c.replace(/"/g, '&quot;')}">`).join('') + list.innerHTML;
      });
      placeIn.addEventListener('change', async () => {
        const name = placeIn.value.trim();
        if (!name) return;
        const ids = placeIn.dataset.ids!.split(',');
        status.textContent = '…';
        const res = await fetch('/api/moments/bulk', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ids, action: 'place', place_name: name }) });
        status.textContent = res.ok ? 'saved' : ((await body(res)).error ?? 'error');
      });
    }
    // Ride route: upload a GPX; the server trims it out of privacy zones and works out the stats.
    pick<HTMLInputElement>(row, '.addroute input').addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      status.textContent = 'reading route…';
      const fd = new FormData();
      fd.append('file', file);
      const res = await fetch(`/api/sets/${id}/route`, { method: 'POST', body: fd });
      if (res.ok) location.reload(); else status.textContent = (await body(res)).error ?? 'error';
    });
    pick<HTMLElement>(row, '.rmroute')?.addEventListener('click', async () => {
      if (!confirm('Remove this ride route?')) return;
      const res = await fetch(`/api/sets/${id}/route`, { method: 'DELETE' });
      if (res.ok) location.reload(); else status.textContent = 'remove failed';
    });
    pick<HTMLElement>(row, '.ungroup').addEventListener('click', async () => {
      if (!confirm('Ungroup this set? Its photos stay on the timeline.')) return;
      const res = await fetch(`/api/sets/${id}`, { method: 'DELETE' });
      if (res.ok) location.reload(); else status.textContent = 'ungroup failed';
    });
  });

  // Inline edits on recent moments: save on change.
  (document.querySelectorAll('.item') as unknown as HTMLElement[]).forEach((item) => {
    const id = item.dataset.id!;
    const status = pick<HTMLElement>(item, '.status');
    const save = async (edit: Record<string, unknown>) => {
      status.textContent = '…';
      const res = await fetch(`/api/moments/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(edit) });
      status.textContent = res.ok ? 'saved' : ((await body(res)).error ?? 'error');
      if (res.ok) setTimeout(() => (status.textContent = ''), 1500);
    };
    pick<HTMLElement>(item, '.caption').addEventListener('change', (e) => {
      const v = (e.target as HTMLInputElement).value;
      pick<HTMLElement>(item, '.sum .cap').textContent = v;
      save({ caption: v });
    });
    pick<HTMLElement>(item, '.place').addEventListener('change', (e) => {
      const v = (e.target as HTMLInputElement).value;
      pick<HTMLElement>(item, '.sum .pn').textContent = v.toLowerCase() || 'no location';
      save({ place_name: v });
    });
    pick<HTMLElement>(item, '.taken').addEventListener('change', (e) => {
      // Keep the photo's original time-zone offset; a value with no seconds gets :00.
      const input = e.target as HTMLInputElement;
      const v = input.value.length === 16 ? input.value + ':00' : input.value;
      if (v) save({ taken_at: v + (input.dataset.offset ?? '') });
    });
    item.querySelectorAll('.cat').forEach((box) => box.addEventListener('change', () => {
      const cats = checked(item, '.cat');
      save({ categories: cats });
    }));
    pick<HTMLElement>(item, '.setsel').addEventListener('change', (e) => save({ set_id: (e.target as HTMLSelectElement).value || null }));
    pick<HTMLElement>(item, '.cover')?.addEventListener('click', async (e) => {
      const btn = e.target as HTMLButtonElement;
      const res = await fetch(`/api/sets/${btn.dataset.set}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cover_id: id }) });
      if (!res.ok) { status.textContent = (await body(res)).error ?? 'error'; return; }
      // Only one cover per set: reset the other stars in the same set.
      (document.querySelectorAll(`.cover[data-set="${btn.dataset.set}"]`) as unknown as HTMLButtonElement[]).forEach((b) => { b.textContent = '☆ cover'; b.setAttribute('aria-pressed', 'false'); });
      btn.textContent = '★ cover';
      btn.setAttribute('aria-pressed', 'true');
    });
    pick<HTMLElement>(item, '.rm').addEventListener('click', async () => {
      if (!confirm('Delete this moment and its files? This cannot be undone.')) return;
      const res = await fetch(`/api/moments/${id}`, { method: 'DELETE' });
      if (res.ok) item.remove(); else status.textContent = 'delete failed';
    });
  });
</script>

