---
import Base from '../layouts/Base.astro';
import Moment from '../components/Moment.astro';
import SetCard from '../components/SetCard.astro';
import { listMoments, listSets } from '../lib/moments';
import { buildEntries, groupEntriesByMonth } from '../lib/timeline';

const [moments, sets] = await Promise.all([listMoments(), listSets()]);
const months = groupEntriesByMonth(buildEntries(moments, sets));
---

<Base current="timeline">
  <main class="tl">
    {months.length === 0 && <p class="empty">nothing here yet</p>}
    {months.map((g) => (
      <>
        <div class="mh"><b>{g.label}</b><span>{g.entries.length}</span></div>
        {g.entries.map((e) => e.type === 'set'
          ? <SetCard set={e.set} moments={e.moments} cover={e.cover} start={e.start} end={e.end} places={e.places} />
          : <Moment m={e.moment} />)}
      </>
    ))}
    {months.length > 0 && <div class="end">that's everything<i></i></div>}
  </main>
</Base>

<style>
  .tl { max-width: 640px; margin: 0 auto; padding: 60px 20px 90px; }
  .empty { margin-top: 40px; color: var(--dim); }
  .mh { display: flex; align-items: center; gap: 10px; margin: 44px 0 18px; color: var(--dim); white-space: nowrap; }
  .mh::before { content: '──'; color: var(--faint); }
  .mh::after { content: ''; flex: 1; border-top: 1px solid var(--faint); }
  .mh b { color: var(--fg); font-weight: 400; }
  .end { margin-top: 60px; color: var(--dim); }
  .end::before { content: '$ '; }
  .end i { display: inline-block; width: 8px; height: 15px; background: var(--fg); vertical-align: -2px; margin-left: 2px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 700px) {
    .tl { padding: 56px 16px 80px; }
  }
</style>
