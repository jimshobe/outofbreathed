---
import Base from '../layouts/Base.astro';
---

<Base current="map">
  <main class="soon"><p>$ map: coming in phase 4<i></i></p></main>
</Base>

<style>
  .soon { min-height: 100dvh; display: grid; place-items: center; color: var(--dim); }
  i { display: inline-block; width: 8px; height: 15px; background: var(--fg); vertical-align: -2px; margin-left: 4px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
</style>
