---
import Base from '../../layouts/Base.astro';
import { listPlaces } from '../../lib/moments';

// Every place (a ~100 m spot with photos) is embedded; panels load their photos on demand.
const places = await listPlaces();
const json = JSON.stringify(places).replace(/</g, '\\u003c');
---

<Base current="map" overlay>
  <div id="map"></div>
  <div id="marks"></div>
  <aside class="panel" id="panel"></aside>
  {places.length === 0 && <p class="empty">$ nothing on the map yet<i></i></p>}
  <footer class="keys">
    <button data-k="n"><b>n</b> newest</button>
    <button data-k="w"><b>w</b> world</button>
    <button data-k="r"><b>r</b> spin</button>
  </footer>
  <script type="application/json" is:inline id="places" set:html={json} />
</Base>

<script>
  import '../../scripts/map';
</script>

<style>
  #map { position: fixed; inset: 0; }
  #map :global(.maplibregl-ctrl-top-right) { top: 40px; }
  #map :global(.maplibregl-ctrl-attrib) { background: #000 !important; color: #555; font: 10px var(--mono); }
  #map :global(.maplibregl-ctrl-attrib a) { color: #555 !important; }
  #map :global(.maplibregl-ctrl-attrib-button) { filter: invert(1) brightness(.4); }
  .empty { position: fixed; inset: 0; display: grid; place-items: center; color: var(--dim); pointer-events: none; }
  .empty i { display: inline-block; width: 8px; height: 15px; background: var(--fg); vertical-align: -2px; margin-left: 4px; animation: blink 1.1s steps(1) infinite; }

  /* markers: drawn by src/scripts/map.ts into #marks, so styled with :global */
  #marks { position: fixed; inset: 0; pointer-events: none; z-index: 5; }
  /* Anchor on the 7px square, not the whole marker: the label beside it would otherwise shift it left. */
  #marks :global(.mk) { position: absolute; transform: translate(-3.5px, -50%); pointer-events: auto; cursor: pointer; display: flex; align-items: center; gap: 8px; white-space: nowrap; }
  #marks :global(.sq) { width: 7px; height: 7px; background: var(--fg); flex: none; }
  #marks :global(.mk:hover .sq) { box-shadow: 0 0 0 3px #000, 0 0 0 4px var(--fg); }
  #marks :global(.lbl) { color: var(--dim); opacity: 0; transition: opacity .2s; display: flex; gap: 8px; align-items: center; }
  #marks :global(.mk:hover .lbl), #marks:global(.labels) :global(.mk:not(.nolabel) .lbl) { opacity: 1; }
  #marks :global(.nm:hover), #marks :global(.i:hover) { color: var(--fg); }
  #marks :global(.i) { color: var(--dim); }
  #marks :global(.mk.group) { transform: translate(-50%, -50%); }
  #marks :global(.group .n) { padding: 2px 4px; background: #000; outline: 1px solid var(--fg); color: var(--fg); }
  #marks :global(.group:hover .n) { background: var(--fg); color: #000; }
  #marks :global(.here .sq) { animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* place panel: content rendered by map.ts */
  .panel { position: fixed; z-index: 20; right: 20px; top: 56px; bottom: 56px; width: min(420px, calc(100% - 40px)); background: #000; outline: 1px solid var(--faint); padding: 18px; overflow: auto; display: none; scrollbar-width: none; }
  .panel:global(.open) { display: block; }
  .panel :global(.cmd) { color: var(--dim); }
  .panel :global(.cmd b) { color: var(--fg); font-weight: 500; }
  .panel :global(.sub), .panel :global(.desc), .panel :global(.note), .panel :global(.loading) { color: var(--dim); }
  .panel :global(.sub) { margin-top: 2px; }
  .panel :global(.tabs) { margin-top: 14px; display: flex; gap: 16px; }
  .panel :global(.tabs button) { color: var(--dim); }
  .panel :global(.tabs button:hover), .panel :global(.tabs .on) { color: var(--fg); }
  .panel :global(.tabs .on[data-mode='photos']::before) { content: '['; }
  .panel :global(.tabs .on[data-mode='photos']::after) { content: ']'; }
  .panel :global(.desc) { margin-top: 16px; }
  .panel :global(.blurb) { margin-top: 8px; color: #cfcfcf; }
  .panel :global(.src) { display: inline-block; margin-top: 6px; color: var(--dim); text-decoration: none; }
  .panel :global(.src:hover) { color: var(--fg); }
  .panel :global(.grid) { margin-top: 18px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
  .panel :global(.grid button) { position: relative; aspect-ratio: 1; background: #111; overflow: hidden; cursor: zoom-in; }
  .panel :global(.grid img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .panel :global(.grid .p) { position: absolute; left: 4px; bottom: 4px; font-size: 10px; background: #000; padding: 0 3px; }
  .panel :global(.sets) { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .panel :global(.sets a) { color: var(--fg); text-decoration: none; }
  .panel :global(.sets a:hover) { text-decoration: underline; }
  .panel :global(ol) { list-style: none; padding: 0; margin-top: 16px; color: var(--dim); }
  .panel :global(ol li) { display: grid; grid-template-columns: 104px 1fr; gap: 8px; cursor: pointer; }
  .panel :global(ol li span:last-child) { color: #cfcfcf; }
  .panel :global(ol li:hover span) { color: var(--fg); }
  .panel :global(.x) { position: absolute; top: 14px; right: 16px; color: var(--dim); }
  .panel :global(.x:hover) { color: var(--fg); }
  .panel :global(.note) { margin-top: 14px; }
  .panel :global(.loading) { margin-top: 18px; }
  .panel :global(.loading i) { display: inline-block; width: 7px; height: 13px; background: var(--fg); vertical-align: -2px; margin-left: 4px; animation: blink 1.1s steps(1) infinite; }

  .keys { position: fixed; right: 20px; bottom: max(14px, env(safe-area-inset-bottom)); z-index: 10; color: var(--dim); }
  .keys button { color: var(--dim); margin-left: 14px; }
  .keys button:hover, .keys button:global(.on) { color: var(--fg); }
  .keys b { color: var(--fg); font-weight: 400; }

  @media (max-width: 700px) {
    .panel { inset: auto 0 0 0; top: auto; width: 100%; max-height: 62%; outline: 0; border-top: 1px solid var(--faint); padding: 16px 16px max(16px, env(safe-area-inset-bottom)); }
    .keys { right: 16px; }
  }
</style>
