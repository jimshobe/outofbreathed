---
// One set: title, dates, caption, then a thumbnail grid (photos and YouTube videos, in the set's order)
// that opens the lightbox, where videos play.
import Base from '../../layouts/Base.astro';
import PlaceLinks from '../../components/PlaceLinks.astro';
import LightboxData from '../../components/LightboxData.astro';
import { getSet, getSetRoute, listMoments, mediaUrl } from '../../lib/moments';
import { fmtRange } from '../../lib/timeline';
import { fmtStats } from '../../lib/route';
import Comments from '../../components/Comments.astro';
import { commentCounts } from '../../lib/comments';

const set = await getSet(Astro.params.id!);
if (!set) return new Response('Not found', { status: 404 });
const moments = await listMoments({ setId: set.id });
const photos = moments.filter((m) => m.media_key);
// Photos and YouTube videos together, in the set's order: the grid and the lightbox both use this.
const viewable = moments.filter((m) => m.media_key || m.youtube_id);
// Each place once, from its first photo (for its map spot and links).
const places = [...new Map(moments.filter((m) => m.place_name).map((m) => [m.place_name!, m] as const)).values()];
const count = (await commentCounts([], [set.id])).get(`s:${set.id}`) ?? 0;
const route = await getSetRoute(set.id);
const stats = set.route_km != null ? fmtStats({ km: set.route_km, secs: set.route_secs ?? null, climb_m: set.route_climb_m ?? null }) : '';
// The route map shows the ride plus photos at their (public) map positions.
const mapJson = route?.length
  ? JSON.stringify({ id: set.id, title: set.title, route, photos: photos.filter((m) => m.display_lat != null).map((m) => ({ id: m.id, lat: m.display_lat, lng: m.display_lng })) }).replace(/</g, '\\u003c')
  : null;
---

<Base current="timeline">
  <main class="tl">
    <a class="back" href={`/#set-${set.id}`}>&lt; timeline</a>
    {Astro.locals.viewer.isOwner && <a class="edit" href={`/manage/sets/${set.id}`}>[edit]</a>}
    <header>
      <h2>{set.title.toLowerCase()}</h2>
      {moments.length > 0 && (
        <p class="meta">
          {fmtRange(moments[0].taken_at, moments[moments.length - 1].taken_at)}
          {places.length > 0 && ' · '}
          {places.map((m, i) => <>{i > 0 && ' · '}<PlaceLinks name={m.place_name} zoned={m.zoned} spot_lat={m.spot_lat} spot_lng={m.spot_lng} /></>)}
        </p>
      )}
      {stats && <p class="stats">{stats}</p>}
      {set.caption && <p class="caption">{set.caption}</p>}
    </header>

    {mapJson && (
      <>
        <div id="setmap" class="setmap" role="img" aria-label={`Route of ${set.title}`}></div>
        <script type="application/json" is:inline id="setmap-data" set:html={mapJson} />
      </>
    )}

    <div class="grid">
      {viewable.map((m) => (
        <a href={`#p-${m.id}`} data-lb-open="set" data-lb-id={m.id} aria-label={m.caption ?? (m.media_key ? 'photo' : 'video')}>
          <img src={m.media_key ? mediaUrl(m.thumb_key ?? m.media_key) : `https://i.ytimg.com/vi/${m.youtube_id}/mqdefault.jpg`} alt="" loading="lazy" />
          {!m.media_key && <span class="play">▶</span>}
        </a>
      ))}
    </div>
    {moments.length === 0 && <p class="meta">this set is empty</p>}
    <Comments on={`s:${set.id}`} count={count} open />
    <LightboxData group="set" moments={viewable} />
  </main>
</Base>

<script>
  import { initLightbox } from '../../scripts/lightbox';
  import '../../scripts/comments';
  initLightbox();
  // Only load MapLibre when this set has a route.
  if (document.getElementById('setmap')) import('../../scripts/setmap');
</script>

<style>
  .tl { max-width: 900px; margin: 0 auto; padding: var(--top) 20px 90px; }
  .back { color: var(--dim); text-decoration: none; }
  .back:hover { color: var(--fg); }
  .edit { float: right; color: var(--dim); text-decoration: none; }
  .edit:hover { color: var(--fg); }
  header { margin: 24px 0 24px; max-width: 640px; }
  h2 { font: 500 15px/1.4 var(--mono); }
  h2::before { content: '> '; color: var(--dim); }
  .meta { color: var(--dim); margin-top: 4px; }
  .caption { margin-top: 10px; }
  .stats { margin-top: 4px; color: var(--fg); }
  .setmap { height: min(360px, 55vh); margin-bottom: 24px; background: #080808; }
  .setmap :global(.maplibregl-ctrl-attrib) { background: #000 !important; color: #555; font: 10px var(--mono); }
  .setmap :global(.maplibregl-ctrl-attrib a) { color: #555 !important; }
  .setmap :global(.maplibregl-ctrl-attrib-button) { filter: invert(1) brightness(.4); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 4px; margin-bottom: 40px; }
  .grid a { position: relative; aspect-ratio: 1; background: #0d0d0d; overflow: hidden; cursor: zoom-in; }
  .grid .play { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font-size: 22px; text-shadow: 0 1px 4px #000; pointer-events: none; }
  .grid img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity .2s; }
  .grid a:hover img { opacity: .85; }
  @media (max-width: 700px) {
    .tl { padding: var(--top) 16px 80px; }
    .grid { grid-template-columns: repeat(3, 1fr); gap: 2px; }
  }
</style>
